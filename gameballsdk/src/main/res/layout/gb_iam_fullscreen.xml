<?xml version="1.0" encoding="utf-8"?>
<!--
  Edge to edge, opaque, no scrim: the surface covers the app and nothing shows past it, so
  there is nothing to dim.

  Two genuinely different compositions rather than one with a part hidden, which is why the
  layout has to arrive on the wire and cannot be guessed from which fields are populated.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- image_only draws this at full bounds, deliberately ignoring the safe area: running
         under the notch and the home indicator is the point of a full-bleed poster. -->
    <ImageView
        android:id="@+id/gb_iam_fs_bleed_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/gb_iam_fs_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/gb_iam_fs_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gb_iam_fs_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gb_iam_fs_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gb_iam_fs_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Outside the scroll view, so copy can never push them off. -->
        <com.gameball.gameball.inappmessaging.ui.GbFlowRow
            android:id="@+id/gb_iam_fs_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gb_iam_fs_close_target"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gb_iam_fs_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/gb_iam_ic_close"
            android:contentDescription="@string/gb_iam_close" />
    </FrameLayout>
</merge>
